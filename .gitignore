# Don't track heavy resources in VCS -- download before bundling
# (small checked-in resources like the exercise library JSON are negated below)
Train/Resources/*
!Train/Resources/StrengthExerciseLibrary.json

# Swift Package Manager build artifacts
.build/

# IDEs
.vscode/
# Per-user Xcode state (schemes, breakpoints, UI state)
xcuserdata/

